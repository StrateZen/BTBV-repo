PORT=3000
HOST=127.0.0.1
DATA_FILE=data/db.json
APP_DOMAIN=
HTTP_PORT=80
HTTPS_PORT=443
APP_SEED_MODE=blank
ENABLE_DEMO_LOGIN=false
EMAIL_DELIVERY_WEBHOOK_URL=
REMINDER_INTERVAL_MS=60000
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_EMILY_NAME=
INITIAL_EMILY_EMAIL=
INITIAL_EMILY_PASSWORD=

# Optional GoHighLevel / LeadConnector integration.
# Without these values the app records dry-run sync logs instead of calling external services.
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_API_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
GHL_AUTO_SYNC_INTERVAL_MS=3600000

# Optional OpenAI vision review for uploaded before photos.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_VISION_DETAIL=high

# Optional workflow webhook URLs keyed by internal event.
# Example: GHL_WORKFLOW_ROOM_COMPLETED_URL=https://services.leadconnectorhq.com/hooks/...
GHL_WORKFLOW_CLIENT_CREATED_URL=
GHL_WORKFLOW_MEMBERSHIP_UPDATED_URL=
GHL_WORKFLOW_ROOM_CREATED_URL=
GHL_WORKFLOW_ROOM_INTAKE_SUBMITTED_URL=
GHL_WORKFLOW_AI_REVIEW_COMPLETED_URL=
GHL_WORKFLOW_EMILY_REVIEW_NEEDED_URL=
GHL_WORKFLOW_RECOMMENDATION_SENT_URL=
GHL_WORKFLOW_ROOM_AFTER_PHOTOS_REQUESTED_URL=
GHL_WORKFLOW_ROOM_COMPLETED_URL=
GHL_WORKFLOW_ROOM_NURTURE_STARTED_URL=
GHL_WORKFLOW_UPSELL_IDENTIFIED_URL=
GHL_WORKFLOW_ROOM_UPDATED_URL=
GHL_WORKFLOW_ASSISTANT_UPDATED_URL=
GHL_WORKFLOW_WARRANTY_UPDATED_URL=
